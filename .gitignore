# Reverse ignore: repository contents are ignored unless explicitly allowed.
*

# Reproducible source and tests (created by later tickets).
!/.gitignore
!/README.md
!/package.json
!/.claude-plugin/
!/.claude-plugin/*.json
!/claude/
!/claude/**/*.ts
!/extensions/
!/extensions/**/*.ts
!/hooks/
!/hooks/**/*.json
!/skills/
!/skills/**/
!/skills/**/SKILL.md
!/src/
!/src/**/
!/src/**/*.ts
!/test/
!/test/**/
!/test/**/*.test.ts

# Pinned runtime artifact metadata, never runtime artifacts themselves.
!/metadata/
!/metadata/duckdb.json

# Planning and generated/runtime state are never source.
/.wayfinder/
/.ralph/
/knowledge/
/runtime/
**/knowledge/
**/runtime/
*.zip
*.exe
*.duckdb
*.sql
*.lock
*.tmp
*.temp
*.cache
**/.cache/
**/node_modules/
**/active-shard*
